NODE_ENV=production
PORT=3000

# En az 32 karakter rastgele. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sitenin tam adresi (https). CORS ve PayTR yönlendirmeleri için kullanılır.
PUBLIC_BASE_URL=https://pulsetrace-pro.onrender.com
# Ek alan adların varsa virgülle ayır (opsiyonel)
CORS_ORIGINS=

# Render'da kalıcı disk bağladıysan: /var/data/pulsetrace.db
DB_PATH=

# ---- E-POSTA (Brevo) ----
BREVO_API_KEY=
# Brevo'da DOĞRULANMIŞ gönderen. Gmail/Outlook adresi KULLANMA, kendi alan adın olsun.
MAIL_FROM_EMAIL=noreply@senin-alanadin.com
MAIL_FROM_NAME=PulseTrace Pro

# ---- PayTR ----
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
